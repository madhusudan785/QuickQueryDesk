# --- QuickQueryDesk Docker Environment Variables ---
# Copy this file to .env in the project root before running docker compose.
#
#   Copy-Item .env.docker.example .env        # Windows PowerShell
#   cp .env.docker.example .env               # Linux / macOS
#
# Then edit .env to set your LLM API key and production JWT secret.

# --- PostgreSQL Container ---
POSTGRES_USER=quickquery
POSTGRES_PASSWORD=quickquery_pass
POSTGRES_DB=quickquerydesk

# --- JWT ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# Must match the URL where the frontend is accessible in Docker.
FRONTEND_URL=http://localhost:3000

# --- LLM ---
# Get an API key at https://console.groq.com/keys (Groq)
# or https://aistudio.google.com/apikey (Google Gemini).
# Leave blank to run with fallback classification (category=Other, priority=Medium)
# and template-based draft replies — the app degrades gracefully without a key.
LLM_API_KEY=key-goes-here
LLM_MODEL=groq/compound-mini
