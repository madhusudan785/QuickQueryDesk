# --- Database ---
# Requires asyncpg driver (used by the app at runtime).
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/dbname

# --- JWT ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
FRONTEND_URL=http://localhost:5173

# --- LLM ---
# Get an API key at https://console.groq.com/keys (or https://aistudio.google.com/apikey for Gemini)
# Leave blank to run with default classification (category=Other, priority=Medium)
# and no AI draft reply — the app degrades gracefully without a key.
LLM_API_KEY=
LLM_MODEL=groq/compound-mini
